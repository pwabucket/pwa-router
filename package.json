{
  "name": "@pwabucket/pwa-router",
  "description": "Hooks and utilities for client-side routing in React applications, designed for Progressive Web Apps (PWAs).",
  "version": "0.0.18",
  "type": "module",
  "keywords": [
    "react",
    "router",
    "pwa",
    "library"
  ],
  "author": "sadiqsalau",
  "repository": {
    "url": "https://github.com/pwabucket/pwa-router",
    "type": "git"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublish": "rm -rf ./dist && npm run build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2"
  }
}
